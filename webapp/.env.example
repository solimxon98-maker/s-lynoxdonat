# =====================================================
# S-LynoxDonat Web App — "webapp/.env" nomi bilan nusxalang.
# Bu qiymatlar OMMAVIY (brauzerda ko'rinadi). Maxfiy kalitlarni bu yerga QO'YMANG.
# Supabase → Project Settings → API (Data API): Project URL va anon (public) key
# =====================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ixtiyoriy: API manzili boshqacha bo'lsa (standart: <SUPABASE_URL>/functions/v1/api)
VITE_API_URL=

# GitHub Pages yo'li (repo nomi bilan): /s-lynoxdonat/  — lokal ishda bo'sh qoldiring
VITE_BASE=
